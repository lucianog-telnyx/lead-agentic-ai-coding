{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRScope",
  "type": "object",
  "properties": {
    "epic": { "type": ["integer", "null"] },
    "basePr": { "type": ["integer", "null"] },
    "draft": { "type": "boolean" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "integer" },
          "title": { "type": "string" },
          "inDiff": { "type": "boolean" },
          "done": { "type": "boolean" }
        },
        "required": ["number", "title", "inDiff", "done"]
      }
    }
  },
  "required": ["issues"]
}
